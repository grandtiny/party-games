    "@party-games/gomoku": "workspace:*",
    "@party-games/manor": "workspace:*",
    "@party-games/poker": "workspace:*",
    "@party-games/shared": "workspace:*",
    "fastify": "^5.6.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.20.5",
    "vitest": "^3.2.4"
  }
