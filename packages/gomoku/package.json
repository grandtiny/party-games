      "types": "./src/tactics.ts",
      "import": "./dist/tactics.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@renju-note/quintet": "0.10.4",
    "renjukit": "0.8.0"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  }
}
